# Źródło danych: wykaz zbiorczy AED w API dane-gov-pl-mirror (lokalna kopia portalu dane.gov.pl).
# Wartości poniżej pasują do lokalnego środowiska z ../README.md (API :8001, frontend portalu :4200).
# Skopiuj do .env.local: cp .env.example .env.local

# Adres API portalu (wersja 1.4), bez końcowego ukośnika.
AED_API_URL=http://localhost:8001/1.4
# Zasób „Defibrylatory AED – wykaz zbiorczy” w zbiorze „Defibrylatory AED w Polsce – zbiór łączony”.
# Po zbudowaniu zbioru od zera numer może być inny: sprawdź go w API, GET /1.4/datasets/<id zbioru>/resources.
AED_RESOURCE_ID=24
# Frontend portalu: z niego budowany jest link do zbioru łączonego w eksporcie i metadanych.
AED_PORTAL_URL=http://localhost:4200
# Jak długo (w sekundach) serwer aplikacji trzyma pobrany wykaz w pamięci.
AED_CACHE_SECONDS=300
